# Variáveis do servidor do blog (API + site). No Easypanel, cole-as na aba "Environment" do serviço.
# Na imagem Docker, os caminhos já apontam para /data; aqui ficam só as que você precisa definir.

# --- Obrigatórias ---
# Pasta do blog em sites/ (ex.: asasdomundo)
SITE=exemplo
# Domínio público, com https e sem barra no fim
SITE_URL=https://exemplo.com.br
# Usuário e hash da senha de aplicação cadastrados no Wordbee (gere com: npm run api:password)
WP_USER=wordbee
WP_APP_PASSWORD_HASH=scrypt:16384:8:1:...:...

# --- Vários blogs no mesmo VPS ---
# Pasta do host montada em todos os blogs (trava global de build)
GLOBAL_BUILD_LOCK_DIR=/shared/build-locks
# Builds simultâneos no VPS inteiro (pico medido ~0,6 GB por build)
GLOBAL_BUILD_SLOTS=2
# Heap máximo do build (MB) e threads do sharp (imagens)
BUILD_MAX_OLD_SPACE_MB=768
SHARP_CONCURRENCY=1

# --- Backup em armazenamento S3-compatível (opcional; ex.: Contabo Object Storage) ---
# BACKUP_S3_ENDPOINT=https://eu2.contabostorage.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=backups-blogs
# BACKUP_S3_ACCESS_KEY=...
# BACKUP_S3_SECRET_KEY=...
# BACKUP_S3_PREFIX=exemplo

# --- Ajustes (os valores abaixo são os padrões) ---
# PORT=8080
# TRUST_PROXY=1
# RATE_LIMIT_PER_MINUTE=120
# MAX_UPLOAD_MB=16
# DAILY_REBUILD_UTC_HOUR=7
# DAILY_BACKUP_UTC_HOUR=6
# BACKUP_RETENTION_DAYS=14
# BUILD_DEBOUNCE_MS=5000
# KEEP_RELEASES=3
