---
import site from "../../../site.config.ts";
import Picture from "../Picture.astro";
import AuthorSignature from "../article/AuthorSignature.astro";
import type { PostView } from "../../lib/posts.ts";
import { formatDate, isoDate } from "../../lib/format.ts";

interface Props {
  post: PostView;
  /** Primeiro card da home: imagem sem lazy (candidata a LCP). */
  priority?: boolean;
  headingLevel?: "h2" | "h3";
}
const { post, priority = false, headingLevel: H = "h2" } = Astro.props;
const cover = post.entry.data.cover;
---
<article class="card post-card">
  <div class="img-box">
    {cover && <Picture src={cover.src} alt={cover.alt} sizes="(max-width: 544px) calc(100vw - 58px), (max-width: 921px) 36vw, 300px" fallbackWidth={480} priority={priority} />}
  </div>
  <div class="post-card-body">
    <a class="post-cat" href={`/category/${post.category.slug}/`}>{post.category.name}</a>
    <H><a href={post.url}>{post.title}</a></H>
    <p class="post-meta">{site.authorProfile ? <AuthorSignature /> : <span class="by">{post.author.name}</span>} / <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time> / <a href={`/category/${post.category.slug}/`}>{post.category.name}</a></p>
    <p class="post-excerpt">{post.excerpt}</p>
  </div>
</article>
