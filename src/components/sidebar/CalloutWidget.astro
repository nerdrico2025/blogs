---
import site from "../../../site.config.ts";
import { linkAttrs } from "../../../shared/settings.ts";
const w = site.sidebar.callout;
---
<section class="callout-card" aria-labelledby="w-callout">
  {w.icon && <div class="callout-card-icon" aria-hidden="true">{w.icon}</div>}
  {w.kicker && <span class="kicker">{w.kicker}</span>}
  <h2 id="w-callout">{w.title}</h2>
  {w.text && <p>{w.text}</p>}
  {w.button.label && w.button.href && <a class="btn btn-white btn-block" {...linkAttrs(w.button.href, site.url)}>{w.button.label} <span aria-hidden="true">→</span></a>}
</section>
