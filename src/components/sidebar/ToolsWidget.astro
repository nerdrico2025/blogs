---
import site from "../../../site.config.ts";
import { linkAttrs } from "../../../shared/settings.ts";
const w = site.sidebar.tools;
---
<section class="card widget tools" aria-labelledby="w-tools">
  {w.icon && <div class="tools-icon" aria-hidden="true">{w.icon}</div>}
  <h2 id="w-tools">{w.title}</h2>
  {w.text && <p>{w.text}</p>}
  <ul>
    {w.items.map((it) => (
      <li>
        {it.icon && <span aria-hidden="true">{it.icon}</span>}
        {it.href ? <a {...linkAttrs(it.href, site.url)}>{it.label}</a> : it.label}
      </li>
    ))}
  </ul>
  {w.button.label && w.button.href && <a class="btn btn-accent btn-block" {...linkAttrs(w.button.href, site.url)}>{w.button.label}</a>}
</section>
