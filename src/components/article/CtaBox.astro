---
import site from "../../../site.config.ts";
const c = site.article.cta;
---
<aside class="cta-box" aria-label={c.label} data-pagefind-ignore>
  <span class="kicker">{c.label}</span>
  <strong class="title">{c.title}</strong>
  <p>{c.text}</p>
  <a class="btn btn-ink" href={c.button.href}>{c.button.label} <span aria-hidden="true">→</span></a>
</aside>
