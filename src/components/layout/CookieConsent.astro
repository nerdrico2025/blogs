---
/**
 * Consentimento de cookies (LGPD). Nada de analytics ou anúncios é carregado
 * antes da escolha. A escolha fica no localStorage do leitor; o link
 * "Preferências de cookies" do rodapé reabre o painel.
 */
import site from "../../../site.config.ts";

const cfg = site.cookies;
const { gaId, adsenseClient } = site.analytics;
const t = site.tracking;
const hasCode = Boolean(t?.gtmId || t?.headCode || t?.bodyCode || site.ads?.headScript);
---
{hasCode && <div id="cc-code" hidden data-gtm={t?.gtmId || undefined} data-head={t?.headCode || undefined} data-body={t?.bodyCode || undefined} data-ads-head={site.ads?.headScript || undefined}></div>}
{cfg.enabled && (
  <div id="cc" class="cc" hidden data-ga={gaId || undefined} data-ads={adsenseClient || undefined}>
    <div class="cc-inner">
      <p>{cfg.text} <a href={cfg.policyHref}>Política de Cookies</a>.</p>
      <div class="cc-actions">
        <button type="button" class="cc-btn cc-ghost" data-cc-open>Preferências</button>
        <button type="button" class="cc-btn cc-white" data-cc="reject">Rejeitar</button>
        <button type="button" class="cc-btn cc-accept" data-cc="accept">Aceitar</button>
      </div>
    </div>
  </div>
  <dialog id="cc-prefs" class="cc-prefs" aria-labelledby="cc-prefs-title">
    <form method="dialog">
      <h2 id="cc-prefs-title">Preferências de cookies</h2>
      <p>Escolha quais cookies permitir. Os necessários mantêm o site funcionando e não podem ser desligados.</p>
      <label class="cc-opt">
        <input type="checkbox" checked disabled />
        <span><strong>Necessários</strong><small>Guardam a sua escolha sobre cookies.</small></span>
      </label>
      <label class="cc-opt">
        <input type="checkbox" name="analytics" />
        <span><strong>{cfg.categories.analytics.label}</strong><small>{cfg.categories.analytics.description}</small></span>
      </label>
      <label class="cc-opt">
        <input type="checkbox" name="ads" />
        <span><strong>{cfg.categories.ads.label}</strong><small>{cfg.categories.ads.description}</small></span>
      </label>
      <div class="cc-actions">
        <button type="submit" class="cc-btn cc-dark" value="save">Salvar escolhas</button>
        <button type="submit" class="cc-btn cc-accept" value="accept">Aceitar todos</button>
      </div>
    </form>
  </dialog>
)}

<script>
  type Consent = { analytics: boolean; ads: boolean; at: number };
  const KEY = "cookie-consent.v1";
  const root = document.getElementById("cc");
  const prefs = document.getElementById("cc-prefs") as HTMLDialogElement | null;

  function read(): Consent | null {
    try {
      const v = JSON.parse(localStorage.getItem(KEY) ?? "null");
      return v && typeof v.analytics === "boolean" ? v : null;
    } catch {
      return null;
    }
  }

  function addScript(src: string, attrs: Record<string, string> = {}) {
    if (document.querySelector(`script[src="${src}"]`)) return;
    const s = document.createElement("script");
    s.async = true;
    s.src = src;
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    document.head.append(s);
  }

  /** Scripts criados por innerHTML não rodam; por isso cada um é recriado. */
  function activate(code: string, target: Element) {
    const tpl = document.createElement("template");
    tpl.innerHTML = code;
    tpl.content.querySelectorAll("script").forEach((old) => {
      const s = document.createElement("script");
      for (const a of old.attributes) s.setAttribute(a.name, a.value);
      s.text = old.text;
      old.replaceWith(s);
    });
    target.append(tpl.content);
  }

  const done = new Set<string>();
  function once(key: string, fn: () => void) {
    if (done.has(key)) return;
    done.add(key);
    fn();
  }

  function applyCode(c: Consent) {
    const code = document.getElementById("cc-code")?.dataset ?? {};
    const w = window as unknown as { dataLayer: unknown[] };
    if (c.analytics) {
      once("tracking", () => {
        if (code.gtm) {
          w.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
          addScript(`https://www.googletagmanager.com/gtm.js?id=${encodeURIComponent(code.gtm)}`);
        }
        if (code.head) activate(code.head, document.head);
        if (code.body) activate(code.body, document.body);
      });
    }
    document.documentElement.classList.toggle("no-ads", !c.ads);
    if (!c.ads) return;
    once("ads", () => {
      if (code.adsHead) activate(code.adsHead, document.head);
      document.querySelectorAll<HTMLElement>(".ad-slot[data-ad-code]").forEach((slot) => {
        // Posição de outro dispositivo fica escondida e não carrega
        if (getComputedStyle(slot).display === "none") return;
        const target = slot.querySelector(".ad-code");
        if (target) activate(slot.dataset.adCode ?? "", target);
      });
    });
  }

  function apply(c: Consent) {
    const ga = root?.dataset.ga;
    const ads = root?.dataset.ads;
    const w = window as unknown as { dataLayer: unknown[]; gtag: (...a: unknown[]) => void };
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag("consent", "default", {
      analytics_storage: c.analytics ? "granted" : "denied",
      ad_storage: c.ads ? "granted" : "denied",
      ad_user_data: c.ads ? "granted" : "denied",
      ad_personalization: c.ads ? "granted" : "denied",
    });
    if (c.analytics && ga) {
      w.gtag("js", new Date());
      w.gtag("config", ga);
      addScript(`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(ga)}`);
    }
    if (c.ads && ads) {
      addScript(`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${encodeURIComponent(ads)}`, { crossorigin: "anonymous" });
    }
    applyCode(c);
  }

  function save(c: Omit<Consent, "at">) {
    const value: Consent = { ...c, at: Date.now() };
    try {
      localStorage.setItem(KEY, JSON.stringify(value));
    } catch {}
    if (root) root.hidden = true;
    apply(value);
  }

  function openPrefs() {
    if (!prefs) return;
    const c = read();
    (prefs.querySelector('[name="analytics"]') as HTMLInputElement).checked = c?.analytics ?? false;
    (prefs.querySelector('[name="ads"]') as HTMLInputElement).checked = c?.ads ?? false;
    prefs.showModal();
  }

  document.querySelectorAll(".ad-close").forEach((b) => b.addEventListener("click", () => b.closest(".ad-slot")?.remove()));

  const current = read();
  if (current) apply(current);
  else if (root) root.hidden = false;

  root?.querySelector('[data-cc="accept"]')?.addEventListener("click", () => save({ analytics: true, ads: true }));
  root?.querySelector('[data-cc="reject"]')?.addEventListener("click", () => save({ analytics: false, ads: false }));
  document.querySelectorAll("[data-cc-open]").forEach((b) => b.addEventListener("click", openPrefs));
  prefs?.addEventListener("close", () => {
    if (prefs.returnValue === "accept") save({ analytics: true, ads: true });
    else if (prefs.returnValue === "save") {
      save({
        analytics: (prefs.querySelector('[name="analytics"]') as HTMLInputElement).checked,
        ads: (prefs.querySelector('[name="ads"]') as HTMLInputElement).checked,
      });
    }
  });
</script>
