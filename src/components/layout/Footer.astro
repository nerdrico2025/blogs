---
import site from "../../../site.config.ts";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <a class="footer-brand" href="/" aria-label={`${site.name}, página inicial`}>
      <img src={site.logo.src} width={site.logo.width} height={site.logo.height} alt={site.logo.alt} loading="lazy" />
    </a>
    {site.footer.text && <p class="footer-text">{site.footer.text}</p>}
    <nav aria-label="Links institucionais">
      <ul class="footer-links">
        {site.footer.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {site.cookies.enabled && <li><button type="button" class="footer-cookie" data-cc-open>Preferências de cookies</button></li>}
      </ul>
    </nav>
    <p class="copyright">© {year} {site.name}. Todos os direitos reservados.</p>
  </div>
</footer>
