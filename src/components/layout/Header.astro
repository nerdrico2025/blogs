---
import site from "../../../site.config.ts";
import Icon from "../Icon.astro";
import Ticker from "./Ticker.astro";
import { headerLogo } from "../../../shared/settings.ts";
import { getPosts } from "../../lib/posts.ts";

const path = Astro.url.pathname;
const logo = headerLogo(site);
// Opção por blog: link de categoria sem artigo publicado sai do menu (os outros links ficam)
let nav = site.nav;
if (site.hideEmptyCategories) {
  const used = new Set((await getPosts()).map((p) => p.category.slug));
  const empty = new Set(site.categories.filter((c) => !used.has(c.slug)).map((c) => `/category/${c.slug}/`));
  nav = nav.filter((item) => !empty.has(item.href));
}
---
<Ticker />
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label={`${site.name}, página inicial`}>
      <img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} />
    </a>
    <button class="menu-toggle" type="button" popovertarget="site-nav" aria-label="Abrir menu">
      <Icon name="menu" />
    </button>
    <nav class="nav" id="site-nav" popover aria-label="Categorias">
      <div class="nav-head">
        <strong>Menu</strong>
        <button class="menu-toggle" type="button" popovertarget="site-nav" popovertargetaction="hide" aria-label="Fechar menu">
          <Icon name="close" />
        </button>
      </div>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
