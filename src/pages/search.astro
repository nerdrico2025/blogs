---
import BaseLayout from "../layouts/BaseLayout.astro";
import TwoColumn from "../components/layout/TwoColumn.astro";
import { TEXTOS } from "../lib/textos.ts";

const t = TEXTOS.busca;
const seo = { title: t.titulo, description: t.descricao, path: "/search/", noindex: true };
---
<BaseLayout seo={seo}>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <TwoColumn>
    <section class="card article search-page">
      <h1>{t.h1}</h1>
      <div id="search" style="margin-top:20px" data-sem-indice={t.semIndice}>
        <noscript>{t.semJs}</noscript>
      </div>
    </section>
  </TwoColumn>
</BaseLayout>
<script is:inline type="module">
  try {
    await import("/pagefind/pagefind-ui.js");
    const ui = new window.PagefindUI({ element: "#search", showSubResults: true, showImages: true, resetStyles: false, autofocus: true });
    const q = new URLSearchParams(location.search).get("q");
    if (q) ui.triggerSearch(q);
  } catch {
    const box = document.getElementById("search");
    box.textContent = box.dataset.semIndice;
  }
</script>
