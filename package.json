    "@fastify/static": "10.1.6",
    "@types/hast": "3.0.4",
    "astro": "7.3.8",
    "fastify": "5.12.7",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.1",
    "pagefind": "1.5.2",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
